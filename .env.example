# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-your-custom-secret-key-goes-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Set to 'mysql' to use MySQL, 'sqlite' is default fallback)
DB_TYPE=sqlite

# MySQL Settings (Only required if DB_TYPE=mysql)
DB_NAME=quiz_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_SECRET=your-google-secret

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_SECRET=your-github-secret

